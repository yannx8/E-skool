# Copy to .env.local, fill, then run: npm install && npm run setup
# Where to find each value is explained in README.md ("Mise en production").

# ---------------------------------------------------------------- REQUIRED
# Supabase > Project Settings > API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY, never share.
SUPABASE_SECRET_KEY=
# Public address of the app, no trailing slash (Vercel domain). Used in
# password-reset emails and parent portal links.
NEXT_PUBLIC_SITE_URL=https://ecole.vercel.app
# Random string protecting the scheduled jobs. Generate: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- SETUP ONLY (not needed on Vercel)
# Supabase > Connect > Session pooler connection string (password percent-encoded).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# First administrator account created by `npm run setup`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administration
SCHOOL_NAME=
# Optional but recommended: lets setup disable public sign-up, set the site URL
# and route auth emails through Resend. https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- EMAIL (optional, recommended)
# Resend (https://resend.com): weekly backup email, owner summary, password reset.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Ecole Les Lauriers <ecole@mondomaine.cm>"
EMAIL_FROM=
# Receives the weekly backup zip.
BACKUP_EMAIL=
# Comma-separated: receive the weekly figures (e.g. the founder).
REPORT_EMAILS=

# ---------------------------------------------------------------- AUTOMATIC WHATSAPP REMINDERS (optional, V2)
# Needs a Meta WhatsApp Business account and an APPROVED template whose body has
# 5 variables in this order: {{1}} parent, {{2}} pupil, {{3}} amount, {{4}} period, {{5}} school.
# Each message is billed by Meta. Leave empty to keep manual "Relancer" buttons only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_API_VERSION=v23.0
