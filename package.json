{
  "name": "e-skool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --db-url \"${TYPES_DB_URL:-postgresql://postgres:postgres@localhost:54329/eskool_test?sslmode=disable}\" --schema public > src/lib/database.types.ts && oxfmt src/lib/database.types.ts",
    "setup": "node --env-file-if-exists=.env.local scripts/setup.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "oxfmt src scripts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "oxfmt": "^0.73.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.9"
  }
}
