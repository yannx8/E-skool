// E-skool data model. Money is integer FCFA. Dates without time are @db.Date.
// Billing follows proven billing tools (QuickBooks, Jackrabbit, Smart School):
// the family pays, each pupil carries charges, a payment is allocated to charges
// oldest-due first, and money rows are voided, never deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
  OWNER
}

enum PupilStatus {
  ACTIVE
  LEFT
  GRADUATED
}

enum Method {
  CASH
  MTN_MOMO
  ORANGE_MONEY
  BANK
  OPENING // paid before the school started using E-skool; touches no account
}

enum AccountKind {
  CASH
  MOBILE
  BANK
}

enum ReceiptSize {
  A5
  THERMAL
}

enum Channel {
  WHATSAPP
  LETTER
  CALL
}

model School {
  id               Int         @id @default(1)
  name             String
  motto            String?
  address          String?
  phone            String?
  email            String?
  receiptSize      ReceiptSize @default(A5)
  receiptNote      String?
  reminderTemplate String
  // Receipt numbers come from this counter inside the payment transaction,
  // so they are gapless and never reused.
  lastReceiptNo    Int         @default(0)
  createdAt        DateTime    @default(now())
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions        Session[]
  paymentsTaken   Payment[]        @relation("PaymentCreatedBy")
  paymentsVoided  Payment[]        @relation("PaymentVoidedBy")
  expensesEntered Expense[]        @relation("ExpenseCreatedBy")
  expensesVoided  Expense[]        @relation("ExpenseVoidedBy")
  promises        PaymentPromise[]
  reminders       Reminder[]
  transfers       Transfer[]
  cashCounts      CashCount[]
  auditLogs       AuditLog[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Year {
  id          Int          @id @default(autoincrement())
  name        String       @unique // "2026-2027"
  startsOn    DateTime     @db.Date
  endsOn      DateTime     @db.Date
  isCurrent   Boolean      @default(false)
  feeItems    FeeItem[]
  enrollments Enrollment[]
}

model Class {
  id          Int          @id @default(autoincrement())
  name        String       @unique // "Class 3", "Nursery 2"
  level       Int // order used for lists and promotion
  active      Boolean      @default(true)
  feeAmounts  FeeAmount[]
  enrollments Enrollment[]
}

// One row of the school's fee table: "Tuition, 2nd installment, due 1 Dec".
model FeeItem {
  id       Int         @id @default(autoincrement())
  yearId   Int
  year     Year        @relation(fields: [yearId], references: [id])
  name     String
  dueOn    DateTime    @db.Date
  // Optional items (transport, canteen) are added per pupil, not billed to everyone.
  optional Boolean     @default(false)
  position Int
  amounts  FeeAmount[]
  charges  Charge[]

  @@unique([yearId, name])
}

// The amount of a fee-table row for one class (a cell of the grid).
model FeeAmount {
  feeItemId Int
  feeItem   FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id])
  amount    Int

  @@id([feeItemId, classId])
}

// The paying household. Siblings share one family account and one receipt.
model Family {
  id                   Int              @id @default(autoincrement())
  name                 String // surname used in lists: "NKENG"
  guardian             String? // who pays: "Mrs Marie Nkeng"
  phone                String? // 9 digits, the WhatsApp number
  phone2               String?
  address              String? // neighbourhood
  notes                String?
  remindersPausedUntil DateTime?        @db.Date
  createdAt            DateTime         @default(now())
  pupils               Pupil[]
  payments             Payment[]
  promises             PaymentPromise[]
  reminders            Reminder[]
}

model Pupil {
  id          Int          @id @default(autoincrement())
  familyId    Int
  family      Family       @relation(fields: [familyId], references: [id])
  code        String       @unique // admission number
  lastName    String
  firstNames  String
  sex         String? // "F" | "M"
  birthDate   DateTime?    @db.Date
  status      PupilStatus  @default(ACTIVE)
  notes       String?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]

  @@index([familyId])
}

// A pupil in a class for one school year. Promotions keep history.
model Enrollment {
  id       Int       @id @default(autoincrement())
  pupilId  Int
  pupil    Pupil     @relation(fields: [pupilId], references: [id])
  yearId   Int
  year     Year      @relation(fields: [yearId], references: [id])
  classId  Int
  class    Class     @relation(fields: [classId], references: [id])
  joinedOn DateTime  @db.Date
  leftOn   DateTime? @db.Date
  charges  Charge[]

  @@unique([pupilId, yearId])
  @@index([yearId, classId])
}

// What a pupil owes: one row per fee-table item, or a one-off (feeItemId null).
model Charge {
  id             Int          @id @default(autoincrement())
  enrollmentId   Int
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])
  feeItemId      Int?
  feeItem        FeeItem?     @relation(fields: [feeItemId], references: [id])
  label          String
  amount         Int
  discount       Int          @default(0)
  discountReason String?
  dueOn          DateTime     @db.Date
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime     @default(now())
  allocations    Allocation[]

  @@unique([enrollmentId, feeItemId])
  @@index([enrollmentId])
}

// Where money sits: the cash box, a MoMo wallet, a bank account.
model Account {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  kind           AccountKind
  active         Boolean     @default(true)
  openingBalance Int         @default(0)
  payments       Payment[]
  expenses       Expense[]
  transfersOut   Transfer[]  @relation("TransferFrom")
  transfersIn    Transfer[]  @relation("TransferTo")
  cashCounts     CashCount[]
}

// Money received from a family. Immutable; a mistake is voided with a reason.
model Payment {
  id          Int          @id @default(autoincrement())
  number      Int          @unique // receipt number
  familyId    Int
  family      Family       @relation(fields: [familyId], references: [id])
  paidOn      DateTime     @db.Date
  amount      Int
  method      Method
  accountId   Int
  account     Account      @relation(fields: [accountId], references: [id])
  reference   String? // MoMo transaction id, bank slip
  payer       String? // who brought the money
  note        String?
  createdAt   DateTime     @default(now())
  createdById Int
  createdBy   User         @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedAt    DateTime?
  voidedById  Int?
  voidedBy    User?        @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason  String?
  allocations Allocation[]

  @@index([familyId])
  @@index([paidOn])
}

// The part of a payment applied to one charge. payment.amount - sum(allocations)
// is the family's credit, applied automatically to the next charges.
model Allocation {
  id        Int      @id @default(autoincrement())
  paymentId Int
  payment   Payment  @relation(fields: [paymentId], references: [id])
  chargeId  Int
  charge    Charge   @relation(fields: [chargeId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([chargeId])
}

// A moratoire: the family promises an amount by a date.
model PaymentPromise {
  id          Int       @id @default(autoincrement())
  familyId    Int
  family      Family    @relation(fields: [familyId], references: [id])
  amount      Int
  dueOn       DateTime  @db.Date
  note        String?
  createdAt   DateTime  @default(now())
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  cancelledAt DateTime?

  @@index([familyId])
}

model Reminder {
  id          Int      @id @default(autoincrement())
  familyId    Int
  family      Family   @relation(fields: [familyId], references: [id])
  channel     Channel
  amountDue   Int
  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([familyId])
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  active   Boolean   @default(true)
  expenses Expense[]
}

model Staff {
  id        Int       @id @default(autoincrement())
  name      String
  position  String?
  phone     String?
  salary    Int       @default(0)
  startedOn DateTime? @db.Date
  active    Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

// Money out. Salaries and advances are expenses linked to a staff member and month.
model Expense {
  id          Int             @id @default(autoincrement())
  spentOn     DateTime        @db.Date
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  description String
  amount      Int
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id])
  payee       String?
  reference   String?
  staffId     Int?
  staff       Staff?          @relation(fields: [staffId], references: [id])
  payMonth    String? // "2026-10" for salary and advances
  createdAt   DateTime        @default(now())
  createdById Int
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  voidedAt    DateTime?
  voidedById  Int?
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])
  voidReason  String?

  @@index([spentOn])
}

// Money moved between accounts: cash deposited at the bank, MoMo withdrawn.
model Transfer {
  id            Int      @id @default(autoincrement())
  movedOn       DateTime @db.Date
  fromAccountId Int
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   Int
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Int
  reference     String?
  note          String?
  createdAt     DateTime @default(now())
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])
}

// A physical count of an account (the cash box). The count becomes the new
// book balance; the difference against expected stays on record.
model CashCount {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id])
  counted     Int
  expected    Int
  note        String?
  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   Int?
  user     User?    @relation(fields: [userId], references: [id])
  action   String // "payment.void", "charge.discount", "fees.update"...
  entity   String
  entityId Int?
  detail   Json?

  @@index([at])
}
